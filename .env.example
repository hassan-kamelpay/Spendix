# ─────────────────────────────────────────────────────────────────────────────
# SPENDIX — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Sheets Integration ─────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → create a project
# 2. Enable "Google Sheets API" in APIs & Services → Library
# 3. Create credentials → API Key (restrict to Sheets API)
# 4. For WRITE access: also create a Service Account, download the JSON key,
#    and share your spreadsheet with the service account email.

VITE_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
VITE_SPREADSHEET_ID=your_google_spreadsheet_id_here
VITE_SHEET_NAME=Expenses

# ── Google OAuth (optional — for user-specific sheets) ───────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── App Config ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Spendix
VITE_APP_VERSION=1.0.0

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to use Google Sheets instead of localStorage
VITE_USE_SHEETS=false
